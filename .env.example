# Root key template. Values are never committed (R9).
# Apps read keys from environment variables first, then a local .env file.
# Extend this list as members migrate — keep names identical to what the code reads.

# Amap / Gaode (langTrack geocode, routes)
AMAP_KEY=

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
ZHIPU_MODEL=GLM-5.3-Flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Daily-report review server (POST 鉴权请求头 X-Review-Token；GET 公开)
REVIEW_TOKEN=

