LLM_PROVIDER=deepseek

# --- LLM_PROVIDER=openai (OpenAI æ OpenAI å¼å®¹ç½å³) ---
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# --- LLM_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- LLM_PROVIDER=deepseek (OpenAI å¼å®¹åè®®, é»è®¤ https://api.deepseek.com/v1) ---
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-v4-pro

# --- LLM_PROVIDER=opencode (local `opencode serve`; free tier, no API key) ---
# Text generation only: the session API cannot accept gacore's tool schemas, so the
# interactive agent graph must stay on another provider.
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_MODEL=glm-5.3-flash-free
OPENCODE_PROVIDER_ID=opencode
OPENCODE_AGENT=
# Optional User-Agent override. Empty (default) sends no override. Setting an
# opencode/<version> value is an explicit opt-in to the free-tier gate: it impersonates
# the official client, may violate upstream terms, and can start returning 403 at any
# time. Prefer the official `opencode` CLI or a paid provider for production.
OPENCODE_CLIENT_UA=
# Reasoning-effort preset sent as ``model.variant`` (e.g. low/high/max; the model's
# default preset over-thinks on large extract material: the free glm-5.3-flash-free
# burned its full 32000-token output cap on hidden reasoning, finish=length, while
# ``low`` finished in ~1/3 the time with valid JSON). Empty = the extract path falls
# back to ``low`` (runner._DEFAULT_EXTRACT_OPENCODE_VARIANT); interactive calls keep
# the model default. An explicit value always wins.
OPENCODE_VARIANT=
# Max attempts per opencode extract call (default 3, clamp 1..5). Invalid output
# (no JSON / a question instead of a result) is retried with a corrective message;
# timeouts are not retried.
OPENCODE_MAX_ATTEMPTS=3
# Optional: run KG extract on opencode while the agent keeps LLM_PROVIDER.
KG_EXTRACT_LLM_PROVIDER=
# --- LLM client timeout / retries (all providers; gacore/llm.py) ---
# Per-request timeout in seconds (default 300). A stalled-but-alive connection is
# what wedged the KG extract channels, so this must not be left to the SDK default.
LLM_TIMEOUT=
# Retries per request (default 1; 0 disables). Invalid values fall back to default.
LLM_MAX_RETRIES=

# --- langTrack KG extract budget (gacore langTrack/extract) ---
# Per-channel hard timeout in seconds (default 900); guards against a wedged channel
# holding asyncio.gather forever.
KG_EXTRACT_CHANNEL_TIMEOUT=
# Per-request LLM timeout for extract channels (default 600). The extract runs a
# reasoning model over a whole day of material, so it needs a wider budget than the
# interactive 300s default; non-opencode extract calls never retry.
KG_EXTRACT_LLM_TIMEOUT=

DEFAULT_MAX_TURNS=40

# --- QQ Bot (gacore.frontends.qq) ---
QQ_APP_ID=
QQ_APP_SECRET=
QQ_ALLOWED_USERS=*
QQ_ADMIN_USERS=           # éå·åé openidï¼å¯è§¦å /rebootï¼* = ç½åååå¨é¨ç¨æ·ï¼çç©º = æ äººå¯éå¯
QQ_LOG_FILE=logs/qq.log

