    %% =====================================================================
    %% withlanggraph 核心对话流程 (codemap 走查, 依据 apps/withlanggraph/src/gacore/graph.py)
    %% 焦点: 主图状态机 → process(create_agent) → 记忆维护 的完整流水, 每条边标真实判据
    %% =====================================================================

    subgraph ENTRY["① 入口/触发  (scheduler · proactive · cli · qq · rerun)"]
        direction LR
        SC["scheduler.run_job<br/>配置: config/schedule.json<br/>(name/schedule/type/window/<br/>cooldown_minutes/deliver_to)<br/>触发: 每30s轮询一次<br/>next_run_time 支持 每日固定 HH:MM<br/>或 every N<d/h/m> 间隔<br/>type 分派: job(LLM图·run_job)<br/>/proactive(主动池·PROACTIVE_POOL)<br/>/extract(KG抽取·run_extract_job→EXTRACT_POOL)"]
        QQ["qq 消息/反馈<br/>文本多消息 1.2s 合并<br/>同用户单轮串行(取消静默)<br/>P3「别问了/不想回答」短句→mute_global(muted_until 7天)+确认回复<br/>出站 _send_markdown→SendReceipt(segments: SegmentReceipt)<br/>markdown 明确失败才降级 plain · timeout/连接不明=unknown 不降级<br/>4500 安全分块逐段回执 · 全段确认才 confirmed<br/>chat log 在 receipt 后只记确认段<br/>V1 Step 6: 最终回复按顺序收集 SendReceipt→_record_companion_sent<br/>仅确认前缀写 agent.message.sent · summary=前缀正文(部分成功加「仅成功发送 N/M 段」)<br/>source_id=sha256(平台id+正文) · 幂等键 qq-agent:&lt;msg_id&gt; · 零确认不写"]
        ACR[("companion/identity.py ActiveCardRepository<br/>data/active_cards.json 唯一读写入口<br/>get/snapshot 只读(读侧 PermissionError 重试3次)<br/>set 读-合并-写(锁按 resolve 路径全进程共享)<br/>临时文件 &lt;name&gt;.&lt;pid&gt;.&lt;uuid8&gt;.tmp + os.replace<br/>PermissionError 重试5次·finally 清 tmp<br/>文件缺失/空白→{} · JSON损坏→读{}但 set 抛<br/>ActiveCardCorruptError 不覆盖(人工改动不被清空)")]
        CC["companion/config.py<br/>COMPANION_MVP_ENABLED(1/true/yes/on)<br/>COMPANION_OWNER_QQ_OPENID(单 owner)<br/>active = 开关打开且 owner 非空<br/>缺 owner→功能关闭·不猜 owner<br/>identity.is_owner / owner_active_card<br/>非 owner/未启用不读卡(直接 None)"]
        CSTORE[("companion/store.py CompanionStore<br/>data/companion.db · COMPANION_DB_PATH 可覆盖<br/>4 表: companion_event/reflection/reflection_source/cursor<br/>每连接 foreign_keys+WAL+busy_timeout=5000<br/>migration BEGIN IMMEDIATE→PRAGMA user_version=1<br/>append_event 幂等键 · commit_reflection_batch 单事务<br/>events_after/events_between/latest_reflections/get_cursor<br/>V1 Step 4: QQ on_message 写 user.message.received<br/>V1 Step 6: 最终回复/主动推送确认后写 agent.message.sent / proactive.message.sent<br/>summary=companion/summary.py minimize_user_message(脱敏·200字)<br/>幂等键 qq-user:&lt;msg_id&gt; · store 异常仅 warning 不阻断聊天")]
        MN["start.py 主进程<br/>_main(): scheduler 线程 + QQ 主循环<br/>main 心跳(每15s) + 优雅停机(stop_event)"]
        RC["proactive=定时主动推送:<br/>交付判定 _qq_push_receipt(qq_results, uid) → (actual_message, owner 平台消息 id) 或 None<br/>V1 Step 6: 确认后 _record_companion_sent 写 proactive.message.sent<br/>summary=actual_message(绝不使用最后 AIMessage) · source_id=owner 平台消息 id(空则 hash)<br/>scheduler 每30s轮询 schedule.json 中<br/>type==proactive 的 job<br/>(proactive_due 过 window+cooldown)→入池<br/>P3 job_guard_allows 闸门顺序:<br/>全局静音(muted_until)→静默时段(quiet_hours 23:30–07:30)<br/>→动态配额(quota_cap 按7日回复率1–4条/日)<br/>→热聊冷却→最小间隔(min_gap_hours=3·复用 last_sent_time)<br/>→失联阈值→活跃时段(active_slot_enabled 默认关)<br/>questions scene 单条问题数 questions_per_push(1/2/2/3)<br/>cli=交互式 REPL: python -m gacore<br/>rerun=补跑: python -m gacore.rerun --day/--week<br/>(run_job 包 runtime.as_of 栅栏:时钟锚/get_time/<br/>每日笔记注入/事实卡/记忆写入全以目标日为今天,<br/>onboard 导出跳过·前日日报只取目标日前落盘)"]
        PC["候选池 proactive_candidates<br/>P2: 日报「想问你」为空时补位<br/>collect_all 四类来源(best-effort·单源失败不中断)<br/>chat_loop=主线程最后一条 HumanMessage 承诺句(ref thread_id:msgN)<br/>kg_todo=kg_edges src=todos·valid_to IS NULL·valid_from 近14天(ref edge_id)<br/>langtrack=daily_stats 连续3天≥02:00入睡 / 近3天屏幕≥前30天均值1.5×<br/>memory_conflict=weekly_stats.pending_candidates 画像缺口<br/>score_candidate: 0.30gain+0.25fresh+0.20spec+0.15answer+0.10novelty-0.30intrusion<br/>select 阈值0.55·同源只取最高分组·question_key 去重<br/>P3 select(muted_sources): 静音来源采集后先过滤·不参与打分<br/>verify_evidence 发送后审计(日期/数字回溯·只记警告)<br/>3.0 出题人 question_composer(先于候选池): 变化面 question_surface(五路信号vs30天基线·程序算)<br/>→LLM 归因出题 L1闲聊/L3关心(3.0 §3)·evidence守卫(编造数字即拒)<br/>→无编号单问 verbatim_single·失败/关闭降级本候选池·别问了只静音出题(日报提醒豁免)"]
    end

    subgraph MAIN["② 主图状态机  graph.build_graph() (核心):<br/>5 个核心节点串联对话流水, 每节点独立职责"]
        direction TB

        subgraph FLOW["主图五节点流水 (classify → wait → process → maintain → cleanup)"]
            S(("START")) --> CL["① classify_message<br/>解析最近 HumanMessage<br/>提取 [IMAGE:] 标记<br/>累积到 pending_images"]
            CL -->|"pending_images 且有文字<br/>或无图无文字"| PR
            CL -->|"pending_images 且无文字"| WT["② wait_for_text<br/>interrupt(): 等用户文字<br/>Command(resume=text)->补 HumanMessage<br/>Command(update)->收更多图, 回环"]
            WT -->|"route_after_wait: 恒进 process<br/>(返回值固定为 'process', 无分支)"| PR

            subgraph PR["③ process = create_agent 子图<br/>(gacore_core)·核心智能"]
                direction LR
                MD["model 节点<br/>调用 LLM"]
                TN[("tool 节点<br/>31 个工具轮询")]
                MD <-->|"reAct 循环<br/>until END/tool 结束"| TN
            end

            PR --> MMX["④ memory_maintain<br/>process 回答后每次自动触发:<br/>CombinedTrigger=keyword 门命中<br/>OR vector 语义召回<br/>(k=3, threshold=0.45)<br/>任一命中才进 LLM judge"]
            MMX --> CU["⑤ cleanup_images<br/>去 [IMAGE:]标记·清 pending_images<br/>清 rollover_context/output_mode"]
        end

        subgraph SIDE["支撑模块 (主图依赖, 非状态机节点)"]
            direction LR
            ST["state.py GAState<br/>working/轮次/exit_reason"]
            MDW["middleware 链<br/>GAPrompt → GATurnLogic →<br/>ModelRetry(1 次退避重试)<br/>瞬时断连→中文友好提示"]
        end
    end

    subgraph MM["③ 记忆维护  (memory_maintain 内部流程)"]
        direction TB
        TR["trigger<br/>CombinedTrigger<br/>(keyword 门 OR 语义召回)"]
        TR -->|"未触发 → 返回 no-op<br/>(不打断对话)"| TRN["no-op"]
        TR -->|"已触发"| JD["judge (LLM)<br/>判定 MERGE / NEW / NOOP"]
        JD --> AP["apply + persist_entry<br/>唯一写入口<br/>写 global_mem + facts +<br/>向量同步 pgvector<br/>(全量 sync_portrait +<br/>当次增量 sync_line;<br/>失败→recall.jsonl)"]
        JD -->|"NOOP"| TRN
        AP --> AU["record_audit<br/>→ memory_audit"]
    end

    subgraph TOOLS["工具集 tools/ (process 的 tool 节点可调用, 按职能归并)"]
