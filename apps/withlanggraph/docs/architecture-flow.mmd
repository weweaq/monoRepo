flowchart TD
    %% =====================================================================
    %% withlanggraph 核心对话流程 (codemap 走查, 依据 apps/withlanggraph/src/gacore/graph.py)
    %% 焦点: 主图状态机 → process(create_agent) → 记忆维护 的完整流水, 每条边标真实判据
    %% =====================================================================

    subgraph ENTRY["① 入口/触发  (scheduler · proactive · cli · qq · rerun)"]
        direction LR
        SC["scheduler.run_job"]
        QQ["qq 消息/反馈"]
        RC["proactive / cli / rerun"]
    end

    subgraph MAIN["② 主图状态机  graph.build_graph() (核心)"]
        direction TB

        subgraph FLOW["对话主流程"]
            S(("START")) --> CL["classify_message<br/>提取 [IMAGE:] 标记<br/>累积到 pending_images"]
            CL -->|"pending_images 且有文字<br/>或无图无文字"| PR
            CL -->|"pending_images 且无文字"| WT["wait_for_text<br/>interrupt(): 等用户文字<br/>Command(resume=text)->补 HumanMessage<br/>Command(update)->收更多图, 回环"]
            WT -->|"route_after_wait: 恒 process"| PR

            subgraph PR["process = create_agent 子图<br/>(gacore_core)"]
                direction LR
                MD["model 节点<br/>调用 LLM"]
                TN[("tool 节点<br/>27 个工具轮询")]
                MD <-->|"reAct 循环<br/>until END/tool 结束"| TN
            end

            PR --> MMX["memory_maintain<br/>对话尾部触发长记忆"]
            MMX --> CU["cleanup_images<br/>去 [IMAGE:]标记·清 pending_images<br/>清 rollover_context/output_mode"]
        end

        subgraph SIDE["支撑模块"]
            direction LR
            ST["state.py GAState<br/>working/轮次/exit_reason"]
            MDW["middleware 链<br/>GAPrompt → GATurnLogic →<br/>ModelRetry(langchain)"]
        end
    end

    subgraph MM["③ 记忆维护  (memory_maintain 内部流程)"]
        direction TB
        TR["trigger<br/>CombinedTrigger<br/>(keyword 门 OR 语义召回)"]
        TR -->|"未触发 → 返回 no-op<br/>(不打断对话)"| TRN["no-op"]
        TR -->|"已触发"| JD["judge (LLM)<br/>判定 MERGE / NEW / NOOP"]
        JD --> AP["apply + persist_entry<br/>唯一写入口<br/>写 global_mem + facts +<br/>向量化 同步 pgvector"]
        JD -->|"NOOP"| TRN
        AP --> AU["record_audit<br/>→ memory_audit"]
    end

    subgraph TOOLS["工具集 tools/ (process 的 tool 节点可调用, 按职能归并)"]
        direction LR
        T1["web_scan/browser/bili"]
        T2["daily_notes/memory_tools"]
        T3["code_run/file_RW"]
        T4["ncm_* / ocr / ask_user"]
        T5["send_email/qq_push"]
        T6["langTrack_stats<br/>读 ETL 事实"]
    end

    subgraph LANG["⑤ langTrack 数据子系统"]
        direction LR
        IG["POST /ingest"]
        RW["原始层 events"]
        ET["ETL 事实层"]
        OU["读方出口<br/>fact_card·report·dashboard·qq_push"]
    end

    subgraph OUT["④ 退出/投递"]
        FB["反馈闭环 feedback.py<br/>edit/confirm/redeliver"]
        LG["jsonl_logger<br/>+ llm_request_log"]
    end

    %% ===== 层间边 (带语义) =====
    SC --> CL
    QQ --> CL
    RC --> CL

    ST <--> FLOW
    MDW -.-> MD

    TN --> T1
    TN --> T2
    TN --> T3
    TN --> T4
    TN --> T5
    TN --> T6

    T6 --> OU
    T2 --- MM

    CL -- 反馈消息 --> FB
    CU --> LG
    CU -. 日报正文 .-> FB

    IG --> RW --> ET --> OU