flowchart TD
    %% =====================================================================
    %% withlanggraph 核心对话流程 (codemap 走查, 依据 apps/withlanggraph/src/gacore/graph.py)
    %% 焦点: 主图状态机 → process(create_agent) → 记忆维护 的完整流水, 每条边标真实判据
    %% =====================================================================

    subgraph ENTRY["① 入口/触发  (scheduler · proactive · cli · qq · rerun)"]
        direction LR
        SC["scheduler.run_job<br/>配置: config/schedule.json<br/>(name/schedule/type/window/<br/>cooldown_minutes/deliver_to)<br/>触发: 每30s轮询一次<br/>next_run_time 支持 每日固定 HH:MM<br/>或 every N<d/h/m> 间隔"]
        QQ["qq 消息/反馈"]
        RC["proactive=定时主动推送:<br/>scheduler 每30s轮询 schedule.json 中<br/>type==proactive 的 job<br/>(proactive_due 过 window+cooldown)→入池<br/>cli=交互式 REPL: python -m gacore<br/>rerun=补跑: python -m gacore.rerun --day"]
    end

    subgraph MAIN["② 主图状态机  graph.build_graph() (核心):<br/>5 个核心节点串联对话流水, 每节点独立职责"]
        direction TB

        subgraph FLOW["主图五节点流水 (classify → wait → process → maintain → cleanup)"]
            S(("START")) --> CL["① classify_message<br/>解析最近 HumanMessage<br/>提取 [IMAGE:] 标记<br/>累积到 pending_images"]
            CL -->|"pending_images 且有文字<br/>或无图无文字"| PR
            CL -->|"pending_images 且无文字"| WT["② wait_for_text<br/>interrupt(): 等用户文字<br/>Command(resume=text)->补 HumanMessage<br/>Command(update)->收更多图, 回环"]
            WT -->|"route_after_wait: 恒进 process<br/>(返回值固定为 'process', 无分支)"| PR

            subgraph PR["③ process = create_agent 子图<br/>(gacore_core)·核心智能"]
                direction LR
                MD["model 节点<br/>调用 LLM"]
                TN[("tool 节点<br/>30 个工具轮询")]
                MD <-->|"reAct 循环<br/>until END/tool 结束"| TN
            end

            PR --> MMX["④ memory_maintain<br/>process 回答后每次自动触发:<br/>CombinedTrigger=keyword 门命中<br/>OR vector 语义召回<br/>(k=3, threshold=0.45)<br/>任一命中才进 LLM judge"]
            MMX --> CU["⑤ cleanup_images<br/>去 [IMAGE:]标记·清 pending_images<br/>清 rollover_context/output_mode"]
        end

        subgraph SIDE["支撑模块 (主图依赖, 非状态机节点)"]
            direction LR
            ST["state.py GAState<br/>working/轮次/exit_reason"]
            MDW["middleware 链<br/>GAPrompt → GATurnLogic →<br/>ModelRetry(langchain)"]
        end
    end

    subgraph MM["③ 记忆维护  (memory_maintain 内部流程)"]
        direction TB
        TR["trigger<br/>CombinedTrigger<br/>(keyword 门 OR 语义召回)"]
        TR -->|"未触发 → 返回 no-op<br/>(不打断对话)"| TRN["no-op"]
        TR -->|"已触发"| JD["judge (LLM)<br/>判定 MERGE / NEW / NOOP"]
        JD --> AP["apply + persist_entry<br/>唯一写入口<br/>写 global_mem + facts +<br/>向量同步 pgvector<br/>(全量 sync_portrait +<br/>当次增量 sync_line;<br/>失败→recall.jsonl)"]
        JD -->|"NOOP"| TRN
        AP --> AU["record_audit<br/>→ memory_audit"]
    end

    subgraph TOOLS["工具集 tools/ (process 的 tool 节点可调用, 按职能归并)"]
        direction LR
        T1["web_scan/browser/bili"]
        T2["daily_notes/memory_tools"]
        T3["code_run/file_RW"]
        T4["ncm_* / ocr / ask_user"]
        T5["send_email/qq_push"]
        T6["langTrack_stats<br/>读 ETL 事实"]
        T7["news_hot_list/news_search/news_list_sources<br/>MCP 桥接 aigroup-news-mcp<br/>(npx stdio 常驻会话+stdout 脏行过滤<br/>崩溃降级为可读错误文本)"]
    end

    subgraph LANG["⑤ langTrack 数据子系统"]
        direction LR
        IG["POST /ingest"]
        RW["原始层 events"]
        ET["ETL 事实层"]
        OU["读方出口<br/>fact_card·report·dashboard·qq_push"]
    end

    subgraph DAILY["⑥ 日报链路 v3 (daily_info_pack · feedback · review_server)"]
        direction LR
        subgraph DP["user message 拼装 _build_job_prompt (块顺序=优先级)"]
            direction TB
            COR[("corrections/{date}.json<br/>fact 订正·superseded 去重<br/>record_correction")]
            PRE[("preferences.json<br/>pref 偏好")]
            CB["〔人工订正〕cap 600<br/>〔用户偏好〕cap 400<br/>独立于 PACK_BUDGET"]
            COR --> CB
            PRE --> CB
        end
        SIP["daily_info_pack.SOURCES 注册表<br/>12 源 key/cap/priority/builder·注册序=priority升序<br/>(config/info_pack.json 覆盖预算<br/>·评审页 /config 改完即生效)<br/>classify_body 四态→header 状态<br/>(状态行守卫: - 开头+关键词≤行首8字符)<br/>_cap_lines 行级截断<br/>_assemble_blocks 整块丢弃熔断<br/>_LONG_TERM 采样: _compact_long_term<br/>global_mem_anchor 全保留+编年史尾窗单一截断<br/>v3.3 手机事实源:<br/>_PHONE_PLACE(15) fact_card卡·轨迹/异常<br/>_PHONE_USAGE(45) daily_stats聚合·作息<br/>_PHONE_NOTIF(65) 通知内容尾窗8条·同源合并<br/>sms/input/clipboard 边界=仅本地+本人邮箱(军规7)"]
        HP[("data/logs/info_pack_health.jsonl<br/>status/chars/full_chars/detail_chars<br/>write_pack_health")]
        DT[("data/logs/pack_detail/{date}/{key}.md<br/>三节: 完整取数详情/渲染文本/实际进包<br/>write_pack_detail · 保留90天<br/>+ _FACT_CARD.md (write_fact_card_detail)")]
        RVW["review_server :8010<br/>/review 锚点批注+diff 视图<br/>/health 矩阵 /health/source 三节归因<br/>/llm-requests 运行回放(llm_runview 重建)<br/>/data 数据目录(data_catalog 纯读盘点·按日取数 /api/data/events)<br/>POST /api/revise(默认)·/api/rerun(需确认)<br/>POST /api/health/refresh(↻重算体检·零LLM)"]
        PS[("data/place_semantics.json<br/>手工语义配置(v3.4): 地点tag/note·区县note<br/>place_semantics.py 加载·mtime缓存·坏文件降级")]
        FC2["fact_card compact<br/>chat system prompt 注入出口<br/>9 sections (含 sleep p45/time_app p55)<br/>预算900 · compact_omitted 透传<br/>v3.3 分工: 当前时刻卡<br/>(_PHONE_* 承担当日全天事实)<br/>v3.4 语义叠加: 手工tag覆盖DB label·note进StayBrief<br/>异地标注 region_suffix(区县≠家)·同点短出合并"]
    end

    subgraph OUT["④ 退出/投递"]
        FB["反馈闭环 feedback.py · 三级修复阶梯<br/>触发=QQ 消息经 feedback_route() 或 评审页<br/>①apply_feedback 确定性补丁<br/>②revise_report_llm 最小修订(默认):<br/>零工具单轮+diff 门禁非目标节逐字不变<br/>③rerun --day 整体重生成(需确认)<br/>_deliver_email 主题 {date}（重生成 vN）"]
        LG["jsonl_logger<br/>+ llm_request_log"]
    end

    %% ===== 层间边 (带语义) =====
    SC --> CL
    QQ --> CL
    RC --> CL

    ST <--> FLOW
    MDW -.-> MD

    TN --> T1
    TN --> T2
    TN --> T3
    TN --> T4
    TN --> T5
    TN --> T6

    T6 --> OU
    T2 --- MM

    CL -- 反馈消息 --> FB
    CU --> LG
    CU -. 日报正文 .-> FB

    IG --> RW --> ET --> OU
    OU --> FC2
    PS -. "语义叠加(tag/note)" .-> FC2
    FC2 -->|"outlet=prompt<br/>system prompt"| PR
    SC -. "daily job" .-> CB
    CB --> SIP
    SIP -->|"build_info_pack"| PR
    SIP -. "SourceStat/三节正文" .-> HP
    SIP -. "best-effort 落盘" .-> DT
    HP --> RVW
    DT --> RVW
    FB --> RVW
    RVW -. "_deliver_revised→scheduler._deliver（与 redeliver_day 同通道）/ run_job(for_day)" .-> FB

    %% ============================================================
    %% 设计规范 (参照 diagram-design 编辑级原则)
    %% 1. 强调色只给 1-2 个焦点: ① process 的 reAct 循环(核心智能 focus)
    %%    ② 反馈闭环 FB(边界/回环 bnd, 虚线强调). 其余一律中性语义.
    %% 2. 模块区分 = 容器淡底色 + 节点白底同色描边; 不做满屏彩色填充.
    %% 3. 节点分档: 状态/存储=淡墨灰(state), 异步/写回=虚线, 焦点=强调橙.
    %%    色系: 入口-蓝 | 主图-绿 | 记忆-紫 | 工具-橙 | langTrack-青 | 出口-粉
    %% ============================================================

    %% --- 节点语义 classDef (模块色一律白底同色描边, 低干扰) ---
    classDef entry fill:#ffffff,stroke:#1E88E5,color:#0D47A1
    classDef main  fill:#ffffff,stroke:#66BB6A,color:#1B5E20
    classDef side  fill:#ffffff,stroke:#9CCC65,color:#33691E
    classDef mem   fill:#ffffff,stroke:#8E24AA,color:#4A148C
    classDef tools fill:#ffffff,stroke:#F9A825,color:#E65100
    classDef lang  fill:#ffffff,stroke:#00ACC1,color:#006064
    classDef out   fill:#ffffff,stroke:#EC407A,color:#880E4F
    classDef state fill:#f3f4f6,stroke:#2D3142,color:#2D3142
    classDef focus fill:#FFF3E0,stroke:#EB6C36,stroke-width:2.5px,color:#B33900
    classDef bnd   fill:#ffffff,stroke:#EB6C36,stroke-width:1.5px,stroke-dasharray:5 4,color:#B33900

    %% --- 容器底色 (模块分界, 低饱和 background) ---
    style ENTRY fill:#EBF3FB,stroke:#1E88E5,stroke-width:1.5px,color:#0D47A1
    style MAIN  fill:#F6FAF5,stroke:#43A047,stroke-width:1.5px,color:#1B5E20
    style FLOW  fill:#EEF7ED,stroke:#66BB6A,color:#1B5E20
    style PR    fill:#FFF3E0,stroke:#EB6C36,stroke-width:2px,color:#B33900
    style SIDE  fill:#F8FBF0,stroke:#9CCC65,color:#33691E
    style MM    fill:#FBF4FB,stroke:#8E24AA,stroke-width:1.5px,color:#4A148C
    style TOOLS fill:#FFFBF0,stroke:#F9A825,stroke-width:1.5px,color:#E65100
    style LANG  fill:#F1FAFC,stroke:#00ACC1,stroke-width:1.5px,color:#006064
    style OUT   fill:#FEF5F7,stroke:#EC407A,stroke-width:1.5px,color:#880E4F

    %% --- 节点归组 (按模块; 焦点/边界/状态单独强调) ---
    class SC,QQ,RC entry
    class S,CL,WT,MMX,CU main
    class MD,TN focus
    class ST state
    class MDW side
    class TR,JD,AP,AU,TRN mem
    class T1,T2,T3,T4,T5,T6 tools
    class IG,RW,ET,OU lang
    class LG out
    class FB bnd
    %% ⑥ 日报链路 v3（2026-10-04 收敛：全部节点可回溯源码）
    class SIP,CB,FC2 main
    class COR,PRE,HP,DT state
    class RVW bnd